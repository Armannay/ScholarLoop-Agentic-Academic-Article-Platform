# ScholarLoop environment. COPY to .env and fill in locally.
# .env is git-ignored. PLACEHOLDERS ONLY in this file - never a real secret.
#
# HARD RULE 2: provider API keys are NOT configured here. They are added at
# runtime through the encrypted account store (app/accounts/), encrypted with
# APP_MASTER_KEY, and resolved at call time. This file only carries non-secret
# runtime wiring plus the one key-encryption key the store cannot work without.

# --- core ---
SCHOLARLOOP_ENV=dev
SCHOLARLOOP_LOG_LEVEL=INFO
SCHOLARLOOP_DATABASE_URL=sqlite+pysqlite:///./scholarloop.sqlite3

# Master key for the encrypted account store (AES-256-GCM envelope encryption).
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Accepts 64 hex chars, base64 of 32 bytes, or a 32+ character passphrase.
# Empty means "account store sealed": the app boots, /api/health reports
# providers.account_store_ready=false, and account operations return a config error.
APP_MASTER_KEY=

# Optional explicit HS256 secret for bearer tokens. When empty, the JWT secret is
# derived from APP_MASTER_KEY with domain separation (never the raw master key).
APP_JWT_SECRET=
# Optional token lifetime in seconds (default 12h).
APP_JWT_TTL_SECONDS=

# --- config paths (relative to the repo root) ---
SCHOLARLOOP_POLICIES_PATH=config/policies.yaml
SCHOLARLOOP_RUBRIC_PATH=config/rubric.yaml
SCHOLARLOOP_RULES_DIR=rules
SCHOLARLOOP_PROJECT_OVERRIDES_PATH=

# --- api ---
SCHOLARLOOP_API_HOST=0.0.0.0
SCHOLARLOOP_API_PORT=8000
# Comma-separated. The Vite dev server proxies /api, so the browser never needs
# cross-origin access; keep this list short.
SCHOLARLOOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend (Vite reads VITE_* from frontend/.env, also git-ignored) ---
# Leave empty so the UI calls same-origin /api and the dev server proxies it.
VITE_API_BASE_URL=
