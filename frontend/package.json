{
  "name": "scholarloop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ScholarLoop UI: projects, briefs, live runs, article viewer, and provider accounts.",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "client": "openapi-typescript ../docs/openapi/openapi.yaml -o src/generated/api-schema.d.ts",
    "prelint": "npm run client --silent",
    "pretest": "npm run client --silent"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "^5.0.5"
  }
}
