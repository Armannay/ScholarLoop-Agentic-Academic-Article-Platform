{
  "name": "scholarloop-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ScholarLoop UI: operator auth, encrypted provider accounts, role bindings, and status console.",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/__tests__/app.test.tsx --bundle --platform=node --format=esm --packages=external --loader:.css=empty --outfile=.vite/app.test.mjs && node --test .vite/app.test.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
