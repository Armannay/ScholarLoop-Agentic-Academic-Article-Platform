{
  "name": "scholarloop-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "ScholarLoop console: projects & briefs, live runs, checkpoint modal, stop report, article viewer, plus the typed OpenAPI client.",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "api:gen": "openapi-typescript ../docs/openapi/openapi.yaml -o src/api/openapi.gen.d.ts",
    "mock": "node ../docs/openapi/mock/server.mjs completion --port 4010",
    "test": "vitest run",
    "playwright": "playwright test",
    "playwright:install": "playwright install chromium",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
