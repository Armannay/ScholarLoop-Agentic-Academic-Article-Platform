# Copy to frontend/.env for local overrides. Git-ignored. Never put a key here:
# the browser is a public place, and the UI only talks to /api.

# Leave empty: requests go same-origin to /api and the dev server proxies them to the
# backend. This is what keeps the preview working when the browser is not the sandbox.
VITE_API_BASE_URL=

# Where the dev server forwards /api. Inside docker compose this is http://backend:8000.
VITE_PROXY_TARGET=http://127.0.0.1:8000
