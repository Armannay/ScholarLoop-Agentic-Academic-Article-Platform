# Copy to frontend/.env for local overrides. Git-ignored. Never put a key here:
# the browser is a public place, and the UI only talks to /api.

# Leave empty: requests go same-origin to /api and the dev server proxies them to
# VITE_PROXY_TARGET. This is what keeps the preview working when the browser is not
# the sandbox.
VITE_API_BASE_URL=

# Where the dev server forwards /api. Default: the Prism mock of the OpenAPI spec
# started with `npm run mock` (docs/openapi/mock/server.mjs, completion scenario,
# port 4010). Inside docker compose the live backend is http://backend:8000.
VITE_PROXY_TARGET=http://127.0.0.1:4010

# Serve /api from the in-memory mock instead of proxying: no backend, no Prism, no keys.
# Used by `make frontend-e2e` and the Playwright smoke test.
VITE_API_MOCK=false
