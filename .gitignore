# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Node / Vite ---
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Secrets: never commit an env file or a keyring ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*.keyring.json
scholarloop.keyring.json

# --- Local runtime state (SQLite dev DB, artifacts, logs) ---
*.sqlite
*.sqlite3
*.db
artifacts/
runs/
.scholarloop/
logs/
*.log

# --- Editors / OS ---
.idea/
.vscode/
.DS_Store

# --- docs/openapi build outputs (regenerate with `npm run client` in docs/openapi) ---
# The `runs/` rule above means local runtime state. The OpenAPI examples of the
# run endpoints are a deliverable, so that directory is re-included explicitly.
!docs/openapi/examples/runs/
docs/openapi/generated/
docs/openapi/.scratch/
# composed Prism documents: `node mock/server.mjs <scenario>` writes one per scenario
docs/openapi/.mock.*.openapi.yaml

# --- Generated typed API client (regenerate: cd frontend && npm run client) ---
frontend/src/generated/
frontend/test-results/
frontend/playwright-report/
