{
  "$defs": {
    "IssueSeverity": {
      "description": "Severity of a quality issue. ``high`` blocks completion.",
      "enum": [
        "low",
        "med",
        "high"
      ],
      "title": "IssueSeverity",
      "type": "string"
    }
  },
  "$id": "https://scholarloop.local/schemas/v1/QualityIssue.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One defect. ``section_id`` is None for whole-article issues (word totals, style).",
  "properties": {
    "id": {
      "maxLength": 40,
      "minLength": 2,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,39}$",
      "title": "Id",
      "type": "string"
    },
    "section_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section Id"
    },
    "severity": {
      "$ref": "#/$defs/IssueSeverity"
    },
    "text": {
      "description": "What is wrong and what would fix it.",
      "maxLength": 600,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "severity",
    "text"
  ],
  "title": "QualityIssue",
  "type": "object"
}
