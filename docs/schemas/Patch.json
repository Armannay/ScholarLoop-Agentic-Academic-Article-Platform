{
  "$defs": {
    "PatchOp": {
      "additionalProperties": false,
      "description": "A single edit. ``old`` is matched literally, so no regex escaping is needed.",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Literal text after which to insert.",
          "title": "Anchor"
        },
        "new": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Replacement text.",
          "title": "New"
        },
        "old": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Literal text to replace or delete.",
          "title": "Old"
        },
        "op": {
          "$ref": "#/$defs/PatchOpType"
        },
        "text": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text to insert or the new section body.",
          "title": "Text"
        }
      },
      "required": [
        "op"
      ],
      "title": "PatchOp",
      "type": "object"
    },
    "PatchOpType": {
      "description": "Patch operation verbs. Payload rules live in contracts.patch.",
      "enum": [
        "replace_text",
        "insert_after",
        "delete_text",
        "replace_section"
      ],
      "title": "PatchOpType",
      "type": "string"
    }
  },
  "$id": "https://scholarloop.local/schemas/v1/Patch.json",
  "additionalProperties": false,
  "description": "An ordered list of ops against one section. Empty ``ops`` is invalid.",
  "properties": {
    "base_version": {
      "description": "Section version this patch was authored against (0 = empty section).",
      "minimum": 0,
      "title": "Base Version",
      "type": "integer"
    },
    "ops": {
      "items": {
        "$ref": "#/$defs/PatchOp"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Ops",
      "type": "array"
    },
    "patch_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional id so a ChangeEntry can point at this patch (patch_ref).",
      "title": "Patch Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "section_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Section Id",
      "type": "string"
    }
  },
  "required": [
    "section_id",
    "base_version",
    "ops"
  ],
  "title": "Patch",
  "type": "object"
}
