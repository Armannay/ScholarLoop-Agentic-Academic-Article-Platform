{
  "$defs": {
    "VerificationStatus": {
      "description": "SourceCard.verification. ``unknown`` is never silently upgraded.",
      "enum": [
        "unknown",
        "verified",
        "mismatch"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "$id": "https://scholarloop.local/schemas/v1/SourceCard.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One reference, with enough metadata to verify it and too little room to pad.\n\n``snippet`` is the only free-text field. ``url`` must be an absolute http(s)\nURL, and ``doi`` is normalised on validation so deduplication is reliable.",
  "properties": {
    "authors": {
      "description": "Family-name-first, as printed; [] only if unattributed.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "doi": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "id": {
      "description": "ULID of this card; referenced by tasks' source_ids.",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snippet": {
      "description": "Quoted or paraphrased support, <= 60 words.",
      "minLength": 1,
      "title": "Snippet",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "venue": {
      "description": "Journal, conference or publisher.",
      "maxLength": 300,
      "minLength": 1,
      "title": "Venue",
      "type": "string"
    },
    "verification": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "unknown"
    },
    "year": {
      "maximum": 2200,
      "minimum": 1400,
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "title",
    "year",
    "venue",
    "snippet"
  ],
  "title": "SourceCard",
  "type": "object"
}
